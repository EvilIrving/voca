<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.CaptureProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.voca.speaker.CAPTURE_PROBE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.PlayProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.voca.speaker.PLAY_PROBE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.FocusProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.voca.speaker.FOCUS_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
